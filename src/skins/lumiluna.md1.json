      "--md-sys-color-tertiary": "#80CBC4",
      "--md-sys-color-on-tertiary": "#004D40",
      "--md-sys-color-tertiary-container": "#00695C",
      "--md-sys-color-on-tertiary-container": "#B2DFDB",
      "--md-sys-color-error": "#E57373",
      "--md-sys-color-on-error": "#3E0000",
      "--md-sys-color-error-container": "#7F0000",
      "--md-sys-color-on-error-container": "#FFCDD2",
      "--md-sys-color-surface": "#303030",
      "--md-sys-color-on-surface": "#FFFFFF",
      "--md-sys-color-surface-dim": "#212121",
      "--md-sys-color-surface-bright": "#757575",
      "--md-sys-color-surface-container-lowest": "#212121",
      "--md-sys-color-surface-container-low": "#2B2B2B",
      "--md-sys-color-surface-container": "#373737",
      "--md-sys-color-surface-container-high": "#424242",
      "--md-sys-color-surface-container-highest": "#505050",
      "--md-sys-color-on-surface-variant": "#B3B3B3",
      "--md-sys-color-outline": "#616161",
      "--md-sys-color-outline-variant": "#444444",
      "--md-sys-color-inverse-surface": "#FAFAFA",
      "--md-sys-color-inverse-on-surface": "#212121",
      "--md-sys-color-inverse-primary": "#3F51B5",
      "--md-sys-color-on-background": "#FFFFFF",
      "--md-sys-color-background": "#303030",
      "--md-sys-shape-corner-extra-small": "2px",
      "--md-sys-shape-corner-small": "2px",
      "--md-sys-shape-corner-medium": "2px",
      "--md-sys-shape-corner-large": "4px",
      "--md-sys-shape-corner-extra-large": "4px",
      "--md-sys-motion-duration-short": "200ms",
      "--md-sys-motion-duration-medium": "300ms",
      "--md-sys-motion-duration-long": "450ms",
      "--md-sys-motion-easing-standard": "cubic-bezier(0.4, 0, 0.2, 1)",
      "--md-sys-motion-easing-emphasized": "cubic-bezier(0.4, 0, 0.2, 1)",
      "--md-sys-motion-easing-emphasized-decelerate": "cubic-bezier(0, 0, 0.2, 1)",
      "--md-sys-motion-spring": "cubic-bezier(0.4, 0, 0.2, 1)",
      "--md-sys-motion-spring-soft": "cubic-bezier(0.4, 0, 0.2, 1)",
      "--md-elevation-1": "0 2px 5px rgba(0, 0, 0, 0.5)",
      "--md-elevation-2": "0 5px 12px rgba(0, 0, 0, 0.52)",
      "--md-elevation-3": "0 9px 20px rgba(0, 0, 0, 0.55)",
      "--lm-scrim-surface": "rgba(33, 33, 33, 0.95)",
      "--lm-hairline": "rgba(255, 255, 255, 0.12)"
