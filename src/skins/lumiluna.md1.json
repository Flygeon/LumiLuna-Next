      "--md-sys-motion-duration-short": "200ms",
      "--md-sys-motion-duration-medium": "300ms",
      "--md-sys-motion-duration-long": "450ms",
      "--md-sys-motion-easing-standard": "cubic-bezier(0.4, 0, 0.2, 1)",
      "--md-sys-motion-easing-emphasized": "cubic-bezier(0.4, 0, 0.2, 1)",
      "--md-sys-motion-easing-emphasized-decelerate": "cubic-bezier(0, 0, 0.2, 1)",
      "--md-sys-motion-spring": "cubic-bezier(0.4, 0, 0.2, 1)",
      "--md-sys-motion-spring-soft": "cubic-bezier(0.4, 0, 0.2, 1)",
      "--md-elevation-1": "0 2px 5px rgba(0, 0, 0, 0.26)",
      "--md-elevation-2": "0 5px 12px rgba(0, 0, 0, 0.28)",
      "--md-elevation-3": "0 9px 20px rgba(0, 0, 0, 0.30)",
      "--lm-scrim-surface": "rgba(250, 250, 250, 0.94)",
      "--lm-hairline": "rgba(0, 0, 0, 0.12)"
    },
    "dark": {
      "--md-sys-color-primary": "#9FA8DA",
      "--md-sys-color-on-primary": "#1A237E",
      "--md-sys-color-primary-container": "#303F9F",
      "--md-sys-color-on-primary-container": "#E8EAF6",
      "--md-sys-color-secondary": "#FF4081",
