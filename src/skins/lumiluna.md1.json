  },
  "css": "/* Material Design 1（2014）：扁平实面、直角、全大写按钮、标准曲线；无毛玻璃 */\n.lm-btn { height: 36px; border-radius: 2px; text-transform: uppercase; letter-spacing: 0.8px; font-weight: 500; }\n.lm-btn--filled:hover { filter: none; box-shadow: 0 2px 5px rgba(0, 0, 0, 0.26); }\n.lm-btn--tonal:hover { filter: none; }\n.lm-icon-btn { border-radius: 50%; }\n.lm-glass { backdrop-filter: none; -webkit-backdrop-filter: none; }"
}
