{
  "formatVersion": 1,
  "manifest": {
    "id": "lumiluna.md1",
    "name": "Material Design 1",
    "version": "1.0.0",
    "author": "LumiLuna",
    "description": "回到 2014：初代 Material Design——靛蓝主色、粉色强调、2px 直角、全大写扁平按钮、标准缓动曲线与纸片阴影；毛玻璃换成实面（禁用 backdrop blur）。",
    "modes": ["light", "dark"],
    "seedColor": false,
    "accent": "#3F51B5"
  },
  "tokens": {
    "light": {
      "--md-sys-color-primary": "#3F51B5",
      "--md-sys-color-on-primary": "#FFFFFF",
      "--md-sys-color-primary-container": "#C5CAE9",
      "--md-sys-color-on-primary-container": "#1A237E",
      "--md-sys-color-secondary": "#FF4081",
      "--md-sys-color-on-secondary": "#FFFFFF",
      "--md-sys-color-secondary-container": "#F8BBD0",
      "--md-sys-color-on-secondary-container": "#880E4F",
      "--md-sys-color-tertiary": "#009688",
      "--md-sys-color-on-tertiary": "#FFFFFF",
      "--md-sys-color-tertiary-container": "#B2DFDB",
      "--md-sys-color-on-tertiary-container": "#004D40",
      "--md-sys-color-error": "#D32F2F",
      "--md-sys-color-on-error": "#FFFFFF",
      "--md-sys-color-error-container": "#FFCDD2",
      "--md-sys-color-on-error-container": "#7F0000",
      "--md-sys-color-surface": "#FFFFFF",
      "--md-sys-color-on-surface": "#212121",
      "--md-sys-color-surface-dim": "#E0E0E0",
      "--md-sys-color-surface-bright": "#FFFFFF",
      "--md-sys-color-surface-container-lowest": "#FFFFFF",
      "--md-sys-color-surface-container-low": "#FAFAFA",
      "--md-sys-color-surface-container": "#F5F5F5",
      "--md-sys-color-surface-container-high": "#EEEEEE",
      "--md-sys-color-surface-container-highest": "#E0E0E0",
      "--md-sys-color-on-surface-variant": "#757575",
      "--md-sys-color-outline": "#BDBDBD",
      "--md-sys-color-outline-variant": "#E0E0E0",
      "--md-sys-color-inverse-surface": "#323232",
      "--md-sys-color-inverse-on-surface": "#FFFFFF",
      "--md-sys-color-inverse-primary": "#C5CAE9",
      "--md-sys-color-on-background": "#212121",
      "--md-sys-color-background": "#FAFAFA",
      "--md-sys-shape-corner-extra-small": "2px",
      "--md-sys-shape-corner-small": "2px",
      "--md-sys-shape-corner-medium": "2px",
      "--md-sys-shape-corner-large": "4px",
