{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口默认能力（最小权限）",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-open",
    "fs:default",
    "store:default",
    "opener:default",
    "opener:allow-open-path",
    "opener:allow-open-url",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister"
  ]
}
