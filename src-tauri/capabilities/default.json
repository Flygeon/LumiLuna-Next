{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口默认能力",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-open",
    "fs:default",
    {
      "identifier": "fs:allow-read-file",
      "allow": [{ "path": "**" }]
    },
    "store:default",
    "opener:default",
    "opener:allow-open-path",
    "opener:allow-open-url",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister"
  ]
}
